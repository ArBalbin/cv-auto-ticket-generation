# ============================================================================
# QueuEx backend — deployment configuration (Render)
# ============================================================================
#
# These are set in the Render dashboard (Environment -> Environment Variables),
# NOT in a file: the repository must never carry real secrets. This file is the
# checklist of what to enter there, with the reason each one matters.
#
# The detector is NOT deployed. It needs the camera, so it keeps running on the
# laptop and pushes detections to this service over HTTPS. Its own settings
# stay in the laptop's .env — see the DETECTOR section at the bottom.
# ============================================================================


# ----------------------------------------------------------------------------
# REQUIRED — the service refuses to start without these
#
# core/config.py -> validate_cloud_config() raises on each of them when
# APP_ENV=production. That is deliberate: every one is a setting that fails
# silently and dangerously if left at its development value.
# ----------------------------------------------------------------------------

# Already set by the Dockerfile; listed here so the requirement is visible.
APP_ENV=production

# Signs the ticket tokens. If unset, config.py generates a random key at import
# — which means every restart invalidates every ticket already issued.
JWT_SECRET_KEY=

# Shared secret between the detector and this service. Must NOT stay at the
# default "detector-secret-token": /yolo/push-frame is the endpoint that
# creates queue entries, and anyone who knows the token can post to it.
# Use the same value in the laptop's .env.
CAM_TOKEN=

# Baked into every printed ticket's QR code. Must be this service's public
# HTTPS URL — a localhost or LAN address here produces tickets whose QR code
# resolves to the student's own phone. The production guard rejects loopback
# for exactly that reason.
PORTAL_BASE_URL=https://your-service.onrender.com

# OAuth client ID for the Flutter app, from Google Cloud Console. Every student
# sign-in verifies the "aud" claim of the Google ID token against this value.
GOOGLE_OAUTH_CLIENT_ID=

# Only required while STAFF_REGISTRATION_ENABLED=1 below.
STAFF_REGISTRATION_CODE=


# ----------------------------------------------------------------------------
# DATABASE — Aiven MySQL
# ----------------------------------------------------------------------------
DB_HOST=your-service.aivencloud.com
DB_PORT=
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=

# Aiven refuses unencrypted connections, so this is not optional.
DB_SSL_MODE=REQUIRED

# Optional: upload ca.pem alongside the app and point at it to verify the
# server certificate as well as encrypt. Without it the connection is still
# TLS, but the server's identity is unverified.
# DB_SSL_CA=ca.pem


# ----------------------------------------------------------------------------
# STUDENT SIGN-IN
# ----------------------------------------------------------------------------
# Only accounts on this domain may register. Anything else is rejected at
# sign-in, which is what keeps the system "for students only".
GBOX_ALLOWED_DOMAIN=gbox.ncf.edu.ph

STUDENT_SESSION_TTL_SECONDS=2592000


# ----------------------------------------------------------------------------
# STAFF SESSIONS AND CORS
#
# The staff dashboard is served from a different origin (Vercel) than this API,
# so the session cookie is cross-site. A cross-site cookie is only sent when it
# is SameSite=None AND Secure — set one without the other and staff appear to
# log in successfully, then every following request is unauthenticated.
# ----------------------------------------------------------------------------
SESSION_COOKIE_SAMESITE=none
SESSION_COOKIE_SECURE=1
SESSION_TTL_SECONDS=86400

# Comma-separated. Must list the dashboard's exact origin — scheme and host,
# no trailing slash. The mobile app does not need an entry: CORS is a browser
# rule and does not apply to it.
CORS_ORIGINS=https://your-dashboard.vercel.app

# Restrict once the hostname is known, e.g. your-service.onrender.com
TRUSTED_HOSTS=*

STAFF_REGISTRATION_ENABLED=1


# ----------------------------------------------------------------------------
# DISABLED FEATURES
# ----------------------------------------------------------------------------
# Leave REDIS_URL unset. The cache is optional, and pointing it at a host that
# does not resolve costs a DNS failure on every start before falling back to
# process memory.

# The ticket upload call in services/ticket_printer.py is commented out, so
# this was configured but never used. Turn both on together or neither.
OBJECT_STORAGE_ENABLED=0


# ----------------------------------------------------------------------------
# NOT SET HERE ON PURPOSE
# ----------------------------------------------------------------------------
# PORT                  Render provides it; config.py reads PORT before API_PORT.
#
# FACE_MATCH_THRESHOLD  0.30 and 0.15 are calibrated values, not site settings.
# FACE_MARGIN_THRESHOLD Read ACCURACY.md section A1 before changing either:
#                       lowering the margin below 0.15 is measured to let
#                       unenrolled strangers through.
#
# QUEUE_* / YOLO_*      Detector and tracker tuning. The defaults in config.py
#                       are the deployed values; override only with a reason.


# ============================================================================
# DETECTOR — the laptop, not this service
# ============================================================================
#
# These belong in the laptop's own .env. Listed here because deploying the
# backend changes two of them, and missing either leaves a working-looking
# system that quietly does nothing.
#
#   API_BASE_URL=https://your-service.onrender.com
#       Where the detector pushes. Still http://127.0.0.1:5000 while the
#       backend runs locally. (127.0.0.1, not localhost: on Windows localhost
#       resolves to ::1 first and each new connection waits ~2s to fall back.)
#
#   CAM_TOKEN=<same value as above>
#       A mismatch is rejected with 401 and no queue entries are ever created.
#
#   SNAPSHOT_FPS=2            (was 15)
#   SNAPSHOT_UPLOAD_ENABLED=0 (alternative: turn the stream off entirely)
#       The dashboard's live camera view. Over loopback 15 fps costs nothing;
#       to a cloud host it is roughly 2.8 Mbps sustained — about 1.2 GB per
#       hour of upload from the laptop's connection.
# ============================================================================
