# Environment
.env
.env.*
# The *.example files are templates: placeholders and comments, never real
# values. They have to be committed — they are how anyone else, or you on a
# new machine, knows which variables the system needs.
!.env.example
!.env.production.example
.venv/
__pycache__/
*.py[cod]
*.log

# Model weights
*.pt
*.pth
*.onnx
*.weights
*.bin

# Training runs & data
runs/
weights/
data/

# Images & videos
*.jpg
*.jpeg
*.jfif
*.png
*.mp4
*.avi

# Face-recognition calibration data (real people's photos — never commit)
calibration_data/
ML/data/tickets/real/

# YOLO evaluation frames — captured from the live queue-zone camera, so they
# contain identifiable people. Same rule as calibration_data: never commit.
ML/yolo_eval/

# Database dumps that carry ROWS: the users table holds a staff password hash,
# and student_profiles holds face embeddings as soon as anyone enrols. Dumps of
# structure only (aiven_deploy_schema.sql) stay committed — they are useful and
# carry nothing private.
database_sql/aiven_deploy_full.sql
database_sql/*_data.sql
database_sql/*_backup.sql

# Evaluation figures ARE wanted in the repo (they are the panel deliverable),
# so re-include them despite the blanket *.png rule above.
!ML/figures/
!ML/figures/*.png

# Generated runtime files
app/tickets/
Tickets/

# Logs
*.err.log
*.out.log

# VS Code
.vscode/
